# Maintainer: Michael Anderson <1427851+endthestart@users.noreply.github.com>
# Release procedure: docs/RELEASING.md in the kflux repository.
_owner=endthestart
pkgname=kflux
pkgver=0.1.0
pkgrel=1
pkgdesc="A Fluxbox-style desktop for KDE apps on Wayland"
arch=('any')
url="https://github.com/${_owner}/kflux"
license=('MIT')
# What the session can't run without; `kflux doctor` checks the same list.
depends=('python' 'labwc' 'waybar' 'swaybg' 'mako' 'wtype' 'wlr-randr')
optdepends=(
  'labwc-kflux: Fluxbox-style window tabs (replaces labwc)'
  'fluxbox: the 27 classic Fluxbox styles in the Styles menu'
  'ttf-terminus-nerd: the kflux-Carbon style font'
  'ttf-dejavu: fallback fonts for Fluxbox styles'
  'swaylock: screen lock (menu, keys)'
  'swayidle: lock after idle (kflux.lockAfterMinutes)'
  'libnotify: kflux notifications (welcome, style changes)'
  'grim: screenshot key (Print)'
  'wireplumber: volume keys (wpctl)'
  'xorg-xwayland: X11 apps, and conky'
  'conky: desktop stats in a corner'
  'plasma-integration: KDE colours and dialogs for Qt apps'
  'breeze: Breeze widget style for KDE apps'
  'breeze-icons: icons in menus and KDE apps'
  'archlinux-xdg-menu: KDE "Open With" menus'
  'xdg-desktop-portal-kde: KDE file dialogs for sandboxed apps'
  'xdg-desktop-portal-wlr: screen sharing'
  'polkit-kde-agent: password prompts for admin actions'
  'konsole: terminal (Alt+F1)'
  'dolphin: file manager'
  'kate: editor for the Configure menu'
  'krunner: run dialog (Alt+F2)'
  'systemsettings: KDE settings modules (network, audio, colours)'
  'plasma-nm: network settings module'
  'plasma-pa: audio settings module'
  'kdeconnect: phone integration'
  'network-manager-applet: network tray icon'
  'wdisplays: display settings'
)
source=("https://github.com/${_owner}/kflux/releases/download/v${pkgver}/kflux-${pkgver}.tar.gz"{,.sig})
sha256sums=('SKIP'
            'SKIP')
validpgpkeys=('KFLUX_RELEASE_KEY_FPR') # kflux release key

package() {
  cd "kflux-${pkgver}"
  make DESTDIR="$pkgdir" PREFIX=/usr install
}
