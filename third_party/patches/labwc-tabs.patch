 	}
@@ -1600,6 +1631,51 @@ run_action(struct view *view, struct action *action,
 	case ACTION_TYPE_DEBUG_TOGGLE_KEY_STATE_INDICATOR:
 		key_state_indicator_toggle();
 		break;
+	case ACTION_TYPE_ACTIVATE_TAB:
+		tabs_activate_at_cursor(ctx);
+		break;
+	case ACTION_TYPE_NEXT_TAB:
+		tabs_cycle(view, 1);
+		break;
+	case ACTION_TYPE_PREVIOUS_TAB:
+		tabs_cycle(view, -1);
+		break;
+	case ACTION_TYPE_GO_TO_TAB:
+		tabs_go_to(view, action_get_int(action, "index", 1));
+		break;
+	case ACTION_TYPE_MOVE_TAB_LEFT:
+		tabs_move(view, -1);
+		break;
+	case ACTION_TYPE_MOVE_TAB_RIGHT:
+		tabs_move(view, 1);
+		break;
+	case ACTION_TYPE_DETACH_TAB:
+		if (view && view->tab_group) {
+			tabs_detach(view);
+			if (view_is_floating(view)) {
+				int offset = rc.theme->titlebar_height;
+				view_move(view, view->pending.x + offset,
+					view->pending.y + offset);
+			}
+			desktop_focus_view(view, /*raise*/ true);
+		}
+		break;
+	case ACTION_TYPE_START_TABBING:
+		if (view) {
+			/* As for Move: mousebinds set the grab context on press */
+			if (view != server.seat.pressed.ctx.view) {
+				interactive_set_grab_context(ctx);
+			}
+			tabs_start_tabbing(view);
+		}
+		break;
+	case ACTION_TYPE_GROUP_WITH_WINDOW_BELOW:
+		tabs_group_with_window_below(view);
+		break;
+	case ACTION_TYPE_JOIN_TAB_GROUP:
+		tabs_join_by_identifier(view,
+			action_get_str(action, "identifier", NULL));
+		break;
 	case ACTION_TYPE_INVALID:
 		wlr_log(WLR_ERROR, "Not executing unknown action");
 		break;
@@ -1649,6 +1725,10 @@ actions_run(struct view *activator, struct wl_list *actions, struct cursor_conte
 		 * previous action
 		 */
 		struct view *view = view_for_action(activator, action, &ctx);
+		/* A previous ActivateTab may have hidden the activator */
+		if (view && view_is_hidden_tab(view)) {
+			view = view->tab_group->active;
+		}
 
 		run_action(view, action, &ctx);
 	}
