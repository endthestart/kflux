diff --git a/include/tabs.h b/include/tabs.h
new file mode 100644
index 0000000..24015c4
--- /dev/null
+++ b/include/tabs.h
@@ -0,0 +1,71 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef LABWC_TABS_H
+#define LABWC_TABS_H
+
+#include <stdbool.h>
+#include <wayland-util.h>
+
+struct view;
+struct cursor_context;
+
+/*
+ * Fluxbox-style tab groups. A group is a list of ordinary views sharing one
+ * frame: only the active member is shown, and it carries the frame state
+ * (geometry, maximized/tiled/fullscreen, workspace, layer...). The others are
+ * hidden, unfocusable and have no foreign-toplevel handle. Whenever the active
+ * member changes, the new one takes over the old one's frame state.
+ */
+struct tab_group {
+	struct wl_list members; /* struct view.tab_link */
+	struct view *active;
+};
+
+/* True if @view is a background (hidden) member of a tab group */
+bool view_is_hidden_tab(struct view *view);
+
+/* Number of members of @view's group, or 1 if not grouped */
+int tabs_count(struct view *view);
+
+/*
+ * Make @view a member of @target's group (creating it if needed), placed
+ * after @after (or last if NULL), and make it the active tab.
+ */
+void tabs_attach(struct view *view, struct view *target, struct view *after);
+
+/* Take @view out of its group, keeping it where it is */
+void tabs_detach(struct view *view);
+
+/* Make @view the active member of its group */
+void tabs_activate(struct view *view);
+
+/* Switch to the next (dir > 0) or previous tab, wrapping */
+void tabs_cycle(struct view *view, int dir);
+
+/* Switch to the nth tab (1-based; negative counts from the end) */
+void tabs_go_to(struct view *view, int index);
+
+/* Move the active tab one place left (dir < 0) or right */
+void tabs_move(struct view *view, int dir);
+
+/* Activate the tab under the cursor (mousebind on a titlebar) */
+void tabs_activate_at_cursor(struct cursor_context *ctx);
+
+/* Tab @view into the topmost window beneath it that it overlaps */
+void tabs_group_with_window_below(struct view *view);
+
+/* Join the topmost visible window whose identifier matches @pattern */
+bool tabs_join_by_identifier(struct view *view, const char *pattern);
+
+/* Interactive tabbing (Fluxbox StartTabbing): an outline follows the cursor */
+void tabs_start_tabbing(struct view *view);
+bool tabs_tabbing_active(void);
+void tabs_tabbing_update(void);
+void tabs_tabbing_finish(struct view *view);
+void tabs_tabbing_cancel(void);
+
+/* Hooks */
+void tabs_on_unmap(struct view *view);
+void tabs_on_moved(struct view *view);
+void tabs_on_title_changed(struct view *view);
+
+#endif /* LABWC_TABS_H */
