+/*
+ * Fluxbox-style tab strip: when the view is in a tab group, the title area is
+ * split into one tab per member, each showing that member's title. The node
+ * descriptors carry the member, for ActivateTab and StartTabbing.
+ */
+static void
+update_tab_strip(struct ssd *ssd)
+{
+	struct view *view = ssd->view;
+	struct theme *theme = rc.theme;
+
+	enum ssd_active_state active;
+	FOR_EACH_ACTIVE_STATE(active) {
+		struct ssd_titlebar_subtree *subtree = &ssd->titlebar.subtrees[active];
+		if (subtree->tabs) {
+			wlr_scene_node_destroy(&subtree->tabs->node);
+			subtree->tabs = NULL;
+		}
+	}
+
+	int count = tabs_count(view);
+	if (!ssd->titlebar.tree || count < 2) {
+		return;
+	}
+	int offset_left, offset_right;
+	get_title_offsets(ssd, &offset_left, &offset_right);
+	int width = view->current.width - offset_left - offset_right;
+	if (width < count) {
+		return;
+	}
+
+	const int padding = 4;
+	const float clear[4] = {0, 0, 0, 0};
+	const float shade[4] = {0, 0, 0, 0.3};
+	int height = theme->titlebar_height;
+
+	FOR_EACH_ACTIVE_STATE(active) {
+		struct ssd_titlebar_subtree *subtree = &ssd->titlebar.subtrees[active];
+		subtree->tabs = lab_wlr_scene_tree_create(subtree->tree);
+		struct font *font = active ?
+			&rc.font_activewindow : &rc.font_inactivewindow;
+
+		int i = 0;
+		struct view *member;
+		wl_list_for_each(member, &view->tab_group->members, tab_link) {
+			int x0 = offset_left + width * i / count;
+			int x1 = offset_left + width * (i + 1) / count;
+			bool selected = member == view->tab_group->active;
+			i++;
+
+			struct wlr_scene_rect *bg = wlr_scene_rect_create(
+				subtree->tabs, x1 - x0, height,
+				selected ? clear : shade);
+			wlr_scene_node_set_position(&bg->node, x0, 0);
+			node_descriptor_create(&bg->node, LAB_NODE_TITLE, view, member);
+
+			if (i < count) {
+				struct wlr_scene_rect *sep = wlr_scene_rect_create(
+					subtree->tabs, 1, height,
+					theme->window[active].border_color);
+				wlr_scene_node_set_position(&sep->node, x1 - 1, 0);
+			}
+
+			int label_width = x1 - x0 - 2 * padding;
+			if (label_width <= 0) {
+				continue;
+			}
+			struct scaled_font_buffer *label =
+				scaled_font_buffer_create(subtree->tabs);
+			if (!label) {
+				continue;
+			}
+			const float *color = selected ?
+				theme->window[active].label_text_color :
+				theme->window[SSD_INACTIVE].label_text_color;
+			scaled_font_buffer_update(label, member->title,
+				label_width, font, color, clear);
+			int x = x0 + padding;
+			if (theme->window_label_text_justify == LAB_JUSTIFY_CENTER) {
+				x += (label_width - label->width) / 2;
+			} else if (theme->window_label_text_justify == LAB_JUSTIFY_RIGHT) {
+				x += label_width - label->width;
+			}
+			wlr_scene_node_set_position(&label->scene_buffer->node,
+				x, (height - label->height) / 2);
+			node_descriptor_create(&label->scene_buffer->node,
+				LAB_NODE_TITLE, view, member);
+		}
+	}
+}
+
+void
+ssd_update_tabs(struct ssd *ssd)
+{
+	ssd_update_title(ssd);
+}
+
 void
 ssd_update_title(struct ssd *ssd)
 {
-	if (!ssd || !rc.show_title) {
+	if (!ssd) {
+		return;
+	}
+	update_tab_strip(ssd);
+	if (!rc.show_title) {
 		return;
 	}
 
diff --git a/src/tabs.c b/src/tabs.c
new file mode 100644
index 0000000..5dc875c
--- /dev/null
+++ b/src/tabs.c
@@ -0,0 +1,561 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Fluxbox-style window tabs. See include/tabs.h for the model.
+ */
+#include "tabs.h"
+#include <assert.h>
+#include <stdlib.h>
+#include <wlr/types/wlr_cursor.h>
+#include <wlr/types/wlr_scene.h>
+#include "common/lab-scene-rect.h"
+#include "common/match.h"
+#include "common/mem.h"
+#include "config/rcxml.h"
+#include "foreign-toplevel/foreign.h"
+#include "input/cursor.h"
+#include "labwc.h"
+#include "node.h"
+#include "ssd.h"
+#include "theme.h"
+#include "view.h"
+#include "window-rules.h"
+
+static struct {
+	struct view *view;
+	struct lab_scene_rect *outline;
+	struct wlr_box geo;
+} tabbing;
+
+bool
+view_is_hidden_tab(struct view *view)
+{
+	return view->tab_group && view->tab_group->active != view;
+}
+
+int
+tabs_count(struct view *view)
+{
+	return view->tab_group ? wl_list_length(&view->tab_group->members) : 1;
+}
+
+/* Tabs are drawn in the server-side titlebar, so both windows need one */
+static bool
+can_tab(struct view *view)
+{
+	return view->mapped && view->ssd_mode == LAB_SSD_MODE_FULL
+		&& !view_has_strut_partial(view);
+}
+
+static void
+update_decorations(struct tab_group *group)
+{
+	struct view *member;
+	wl_list_for_each(member, &group->members, tab_link) {
+		ssd_update_tabs(member->ssd);
+	}
+}
+
+/* Hidden members and unmapped views have no taskbar entry */
+static void
+update_foreign_toplevel(struct view *view)
+{
+	bool want = view->mapped && view_is_focusable(view)
+		&& window_rules_get_property(view, "skipTaskbar") != LAB_PROP_TRUE;
+	if (want && !view->foreign_toplevel) {
+		view->foreign_toplevel = foreign_toplevel_create(view);
+	} else if (!want && view->foreign_toplevel) {
+		foreign_toplevel_destroy(view->foreign_toplevel);
+		view->foreign_toplevel = NULL;
+	}
+}
+
+/*
+ * Make @view the active member of @group. It takes over the frame state,
+ * stacking position, taskbar entry and (if it had it) focus of the old one.
+ */
+static void
+set_active(struct tab_group *group, struct view *view)
+{
+	struct view *old = group->active;
+	if (old == view) {
+		return;
+	}
+	bool had_focus = old && server.active_view == old;
+	group->active = view;
+
+	if (old) {
+		view_take_frame_state(view, old);
+
+		/* Take the old member's place in the stacking order */
+		wl_list_remove(&view->link);
+		wl_list_insert(old->link.prev, &view->link);
+		if (view->scene_tree->node.parent == old->scene_tree->node.parent) {
+			wlr_scene_node_place_above(&view->scene_tree->node,
+				&old->scene_tree->node);
+		}
+
+		/* Keep the group's taskbar entry, now showing this tab */
+		if (old->foreign_toplevel) {
+			if (view->foreign_toplevel) {
+				foreign_toplevel_destroy(view->foreign_toplevel);
+			}
+			view->foreign_toplevel = old->foreign_toplevel;
+			old->foreign_toplevel = NULL;
+			foreign_toplevel_set_view(view->foreign_toplevel, view);
+		}
+	}
+
+	view_update_visibility(view);
+	update_foreign_toplevel(view);
+	if (old) {
+		view_update_visibility(old);
+		update_foreign_toplevel(old);
+	}
+	if (had_focus) {
+		desktop_focus_view(view, /*raise*/ false);
+	}
+	update_decorations(group);
+	cursor_update_focus();
+}
+
+static struct view *
+neighbour(struct view *view)
+{
+	struct tab_group *group = view->tab_group;
+	struct wl_list *next = view->tab_link.next;
+	if (next == &group->members) {
+		next = view->tab_link.prev;
+	}
+	if (next == &group->members) {
+		return NULL;
+	}
+	struct view *other = wl_container_of(next, other, tab_link);
+	return other == view ? NULL : other;
+}
+
+static void
+leave_group(struct view *view)
+{
+	struct tab_group *group = view->tab_group;
+	if (!group) {
+		return;
+	}
+	struct view *next = group->active == view ? neighbour(view) : NULL;
+
+	wl_list_remove(&view->tab_link);
+	wl_list_init(&view->tab_link);
+	view->tab_group = NULL;
+
+	if (next) {
+		set_active(group, next);
+	}
+	/* Show the view again and give it its own taskbar entry */
+	view_update_visibility(view);
+	update_foreign_toplevel(view);
+	ssd_update_tabs(view->ssd);
+
+	if (wl_list_length(&group->members) == 1) {
+		struct view *last =
+			wl_container_of(group->members.next, last, tab_link);
+		wl_list_remove(&last->tab_link);
+		wl_list_init(&last->tab_link);
+		last->tab_group = NULL;
+		ssd_update_tabs(last->ssd);
+		free(group);
+	} else if (!wl_list_empty(&group->members)) {
+		update_decorations(group);
+	} else {
+		free(group);
+	}
+}
+
+static void
+join(struct view *view, struct view *target, struct view *after, bool activate)
+{
+	if (target->tab_group) {
+		target = target->tab_group->active;
+	}
+	if (view == target || !can_tab(view) || !can_tab(target)
+			|| (view->tab_group && view->tab_group == target->tab_group)) {
+		return;
+	}
+	if (server.grabbed_view == view) {
+		interactive_cancel(view);
+	}
+	leave_group(view);
+
+	struct tab_group *group = target->tab_group;
+	if (!group) {
+		group = znew(*group);
+		wl_list_init(&group->members);
+		wl_list_insert(&group->members, &target->tab_link);
+		group->active = target;
+		target->tab_group = group;
+	}
+	if (after && after->tab_group == group) {
+		wl_list_insert(&after->tab_link, &view->tab_link);
+	} else {
+		wl_list_insert(group->members.prev, &view->tab_link);
+	}
+	view->tab_group = group;
+
+	if (activate) {
+		set_active(group, view);
+		return;
+	}
+
+	/* Join in the background, sized like the frame */
+	bool had_focus = server.active_view == view;
+	view_move_resize(view, group->active->pending);
+	view_update_visibility(view);
+	update_foreign_toplevel(view);
+	if (had_focus) {
+		desktop_focus_view(group->active, /*raise*/ false);
+	}
+	update_decorations(group);
+	cursor_update_focus();
+}
+
+void
+tabs_attach(struct view *view, struct view *target, struct view *after)
+{
+	assert(view);
+	assert(target);
+	join(view, target, after, /*activate*/ true);
+}
+
+void
+tabs_detach(struct view *view)
+{
+	assert(view);
+	leave_group(view);
+}
+
+void
+tabs_activate(struct view *view)
+{
+	assert(view);
+	if (view->tab_group && view->mapped) {
+		set_active(view->tab_group, view);
+	}
+}
+
+void
+tabs_cycle(struct view *view, int dir)
+{
+	if (!view || !view->tab_group) {
+		return;
+	}
+	struct tab_group *group = view->tab_group;
+	struct wl_list *link = &group->active->tab_link;
+	link = dir > 0 ? link->next : link->prev;
+	if (link == &group->members) {
+		link = dir > 0 ? link->next : link->prev;
+	}
+	struct view *next = wl_container_of(link, next, tab_link);
+	set_active(group, next);
+}
+
+void
+tabs_go_to(struct view *view, int index)
+{
+	if (!view || !view->tab_group || index == 0) {
+		return;
+	}
+	struct tab_group *group = view->tab_group;
+	int count = wl_list_length(&group->members);
+	if (index < 0) {
+		index += count + 1;
+	}
+	if (index < 1 || index > count) {
+		return;
+	}
+	struct view *member;
+	wl_list_for_each(member, &group->members, tab_link) {
+		if (--index == 0) {
+			set_active(group, member);
+			return;
+		}
+	}
+}
+
+void
+tabs_move(struct view *view, int dir)
+{
+	if (!view || !view->tab_group) {
+		return;
+	}
+	struct tab_group *group = view->tab_group;
+	view = group->active;
+	struct wl_list *link = &view->tab_link;
+	if (dir < 0 && link->prev != &group->members) {
+		struct wl_list *before = link->prev->prev;
+		wl_list_remove(link);
+		wl_list_insert(before, link);
+	} else if (dir > 0 && link->next != &group->members) {
+		struct wl_list *after = link->next;
+		wl_list_remove(link);
+		wl_list_insert(after, link);
+	} else {
+		return;
+	}
+	update_decorations(group);
+}
+
+/* The member a tab label or background stands for, if any */
+static struct view *
+tab_member_from_node(struct wlr_scene_node *node)
+{
+	if (!node || !node->data) {
+		return NULL;
+	}
+	struct node_descriptor *desc = node->data;
+	if (desc->type != LAB_NODE_TITLE || !desc->data) {
+		return NULL;
+	}
+	return desc->data;
+}
+
+void
+tabs_activate_at_cursor(struct cursor_context *ctx)
+{
+	if (!ctx || ctx->type != LAB_NODE_TITLE) {
+		return;
+	}
+	struct view *owner = ctx->view;
+	struct view *member = tab_member_from_node(ctx->node);
+	if (!member || !member->tab_group || !owner
+			|| member->tab_group != owner->tab_group
+			|| member == member->tab_group->active) {
+		return;
+	}
+	set_active(member->tab_group, member);
+
+	/*
+	 * The strip was rebuilt and the pressed view is now hidden. Re-point
+	 * the press at the new tab, so that a following Drag (Move) or Click
+	 * mousebind acts on it.
+	 */
+	struct cursor_context now = get_cursor_context();
+	if (server.seat.pressed.ctx.view == owner) {
+		cursor_context_save(&server.seat.pressed, &now);
+	}
+	if (server.grabbed_view == owner
+			&& server.input_mode == LAB_INPUT_STATE_PASSTHROUGH) {
+		server.grabbed_view = NULL;
+		interactive_set_grab_context(&now);
+	}
+	*ctx = now;
+}
+
+void
+tabs_group_with_window_below(struct view *view)
+{
+	if (!view) {
+		return;
+	}
+	if (view->tab_group) {
+		view = view->tab_group->active;
+	}
+	struct view *below = NULL, *fallback = NULL;
+	struct view *v = view;
+	while ((v = view_next(&server.views, v,
+			LAB_VIEW_CRITERIA_CURRENT_WORKSPACE))) {
+		if (v->minimized || !can_tab(v)
+				|| (view->tab_group && v->tab_group == view->tab_group)) {
+			continue;
+		}
+		if (!fallback) {
+			fallback = v;
+		}
+		struct wlr_box overlap;
+		if (wlr_box_intersection(&overlap, &view->current, &v->current)) {
+			below = v;
+			break;
+		}
+	}
+	struct view *other = below ? below : fallback;
+	if (!other) {
+		return;
+	}
+	/* Bring the other window (or its whole group) into this frame */
+	if (!other->tab_group) {
+		join(other, view, NULL, /*activate*/ false);
+		return;
+	}
+	struct wl_array members;
+	wl_array_init(&members);
+	struct view *member;
+	wl_list_for_each(member, &other->tab_group->members, tab_link) {
+		struct view **entry = wl_array_add(&members, sizeof(*entry));
+		if (entry) {
+			*entry = member;
+		}
+	}
+	struct view **entry;
+	wl_array_for_each(entry, &members) {
+		join(*entry, view, NULL, /*activate*/ false);
+	}
+	wl_array_release(&members);
+}
+
+bool
+tabs_join_by_identifier(struct view *view, const char *pattern)
+{
+	if (!view || !pattern || view->tab_group) {
+		return false;
+	}
+	struct view *v;
+	for_each_view(v, &server.views, LAB_VIEW_CRITERIA_CURRENT_WORKSPACE) {
+		if (v == view || v->minimized || !can_tab(v)) {
+			continue;
+		}
+		if (match_glob(pattern, v->app_id)) {
+			join(view, v, NULL, /*activate*/ true);
+			if (view->tab_group && server.active_view == view) {
+				view_move_to_front(view);
+			}
+			return view->tab_group;
+		}
+	}
+	return false;
+}
+
+/* Interactive tabbing */
+
+bool
+tabs_tabbing_active(void)
+{
+	return tabbing.view;
+}
+
+void
+tabs_start_tabbing(struct view *view)
+{
+	assert(view);
+	if (server.input_mode != LAB_INPUT_STATE_PASSTHROUGH
+			|| view != server.grabbed_view
+			|| view->fullscreen || !can_tab(view)) {
+		return;
+	}
+	tabbing.view = view;
+	seat_focus_override_begin(&server.seat, LAB_INPUT_STATE_MOVE,
+		LAB_CURSOR_GRAB);
+	tabs_tabbing_update();
+}
+
+void
+tabs_tabbing_update(void)
+{
+	struct view *view = tabbing.view;
+	if (!view) {
+		return;
+	}
+	if (!tabbing.outline) {
+		struct lab_scene_rect_options opts = {
+			.border_colors = (float *[3]) {
+				rc.theme->osd_bg_color,
+				rc.theme->osd_label_text_color,
+				rc.theme->osd_bg_color,
+			},
+			.nr_borders = 3,
+			.border_width = 1,
+		};
+		tabbing.outline = lab_scene_rect_create(server.menu_tree, &opts);
+	}
+	struct border margin = ssd_get_margin(view->ssd);
+	tabbing.geo = (struct wlr_box){
+		.x = server.grab_box.x + (server.seat.cursor->x - server.grab_x),
+		.y = server.grab_box.y + (server.seat.cursor->y - server.grab_y),
+		.width = server.grab_box.width,
+		.height = server.grab_box.height,
+	};
+	lab_scene_rect_set_size(tabbing.outline,
+		tabbing.geo.width + margin.left + margin.right,
+		tabbing.geo.height + margin.top + margin.bottom);
+	wlr_scene_node_set_position(&tabbing.outline->tree->node,
+		tabbing.geo.x - margin.left, tabbing.geo.y - margin.top);
+	wlr_scene_node_set_enabled(&tabbing.outline->tree->node, true);
+	wlr_scene_node_raise_to_top(&tabbing.outline->tree->node);
+}
+
+void
+tabs_tabbing_cancel(void)
+{
+	tabbing.view = NULL;
+	if (tabbing.outline) {
+		wlr_scene_node_destroy(&tabbing.outline->tree->node);
+		tabbing.outline = NULL;
+	}
+}
+
+/*
+ * Dropped on another window's titlebar: join that group as its active tab,
+ * next to the tab under the cursor. Dropped anywhere else: leave the group
+ * (if any) and move to the outline.
+ */
+void
+tabs_tabbing_finish(struct view *view)
+{
+	struct wlr_box geo = tabbing.geo;
+	struct cursor_context ctx = get_cursor_context();
+	tabs_tabbing_cancel();
+	interactive_cancel(view);
+
+	struct view *target = ctx.view;
+	if (target && target != view
+			&& node_type_contains(LAB_NODE_TITLEBAR, ctx.type)) {
+		if (view->tab_group && target->tab_group == view->tab_group) {
+			return;
+		}
+		struct view *after = tab_member_from_node(ctx.node);
+		tabs_attach(view, target, after);
+		if (view->tab_group) {
+			desktop_focus_view(view, /*raise*/ true);
+		}
+		return;
+	}
+	if (view->tab_group) {
+		leave_group(view);
+		desktop_focus_view(view, /*raise*/ true);
+	}
+	if (view_is_floating(view)) {
+		view_move(view, geo.x, geo.y);
+	}
+}
+
+/* Hooks */
+
+void
+tabs_on_unmap(struct view *view)
+{
+	if (tabbing.view == view) {
+		tabs_tabbing_cancel();
+	}
+	leave_group(view);
+}
+
+/* Keep hidden members sized like the frame so a switch shows no stale size */
+void
+tabs_on_moved(struct view *view)
+{
