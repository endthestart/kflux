HOME = os.path.expanduser("~")
XDG_CONFIG = os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config"))
XDG_DATA = os.environ.get("XDG_DATA_HOME", os.path.join(HOME, ".local/share"))
XDG_CACHE = os.environ.get("XDG_CACHE_HOME", os.path.join(HOME, ".cache"))
KFLUX = os.path.join(XDG_CONFIG, "kflux")
SYSTEM = os.environ.get("KFLUX_SYSTEM", "/usr/share/kflux")
FLUXBOX_STYLES = os.environ.get("KFLUX_FLUXBOX_STYLES", "/usr/share/fluxbox/styles")
GEN_THEME = "kflux-current"
VERSION = "0.1.0"
STYLE_DIRS = [os.path.join(KFLUX, "styles"), os.path.join(SYSTEM, "styles"), FLUXBOX_STYLES]
WARNINGS = []


def warn(msg):
    WARNINGS.append(msg)


def esc(s):
    return html.escape(str(s), quote=True)


def mlabel(s):
    """Menu label: labwc treats '_' as an accelerator marker; '__' is a literal."""
    return esc(str(s).replace("_", "__"))


def write(path, text, mode=0o644):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def expand(p):
    if not p:
        return p
    p = p.strip()
    if p.startswith("~/.config/"):  # honour XDG_CONFIG_HOME for config paths
        p = os.path.join(XDG_CONFIG, p[len("~/.config/"):])
    return os.path.expandvars(os.path.expanduser(p))


# --------------------------------------------------------------------------
# X resource database (init files and styles share this syntax)
# --------------------------------------------------------------------------

class ResourceDB:
    """Minimal Xrm-style database: `pattern: value` with `*` loose bindings."""

    def __init__(self):
        self.entries = []  # (pattern components, value, order)

    @classmethod
    def load(cls, path):
        db = cls()
        if path and os.path.isfile(path):
            with open(path, encoding="utf-8", errors="replace") as f:
                db.parse(f.read())
        return db

    def parse(self, text):
        text = re.sub(r"\\\n", "", text)
        for line in text.splitlines():
            line = line.strip()
            if not line or line[0] in "!#":
                continue
            if ":" not in line:
                continue
            key, val = line.split(":", 1)
            key = key.strip()
            val = val.strip()
            comps = re.split(r"(\*|\.)", key)
            pat = []
            loose = False
            for c in comps:
                if c == "*":
                    loose = True
                elif c == "." or c == "":
                    continue
                else:
                    pat.append(("*" if loose else ".", c.lower()))
                    loose = False
            if loose:
                pat.append(("*", "?"))
            self.entries.append((pat, val, len(self.entries)))

    @staticmethod
    def _match(pat, name):
        # Returns a specificity tuple or None. Earlier exact components win.
        def rec(pi, ni):
            if pi == len(pat):
                return () if ni == len(name) else None
            binding, comp = pat[pi]
            best = None
            starts = [ni] if binding == "." else range(ni, len(name))
            for s in starts:
                if s >= len(name):
                    break
                if comp == "?" or comp == name[s]:
                    rest = rec(pi + 1, s + 1)
                    if rest is not None:
                        score = ((2 if binding == "." and comp != "?" else
                                  1 if comp != "?" else 0),) + rest
                        # Skipped components count as weakest matches.
                        score = (0,) * (s - ni) + score
                        if best is None or score > best:
                            best = score
            return best
        return rec(0, 0)

    def get(self, key, default=None):
        name = key.lower().split(".")
        best, bestval = None, default
        for pat, val, order in self.entries:
            sc = self._match(pat, name)
            if sc is None:
                continue
            sc = sc + (order,)
            if best is None or sc > best:
                best, bestval = sc, val
        return bestval

    def first(self, *keys, default=None):
        for k in keys:
            v = self.get(k)
            if v not in (None, ""):
                return v
        return default


